# ============================================================
# gpt2apirs 运行配置
# 位置：与「可执行文件同目录」（target/debug/.env、target/release/.env）
# 该文件已在 .gitignore 中，不会入库
# ============================================================

# ---------- 必填 ----------
# PostgreSQL 18.0 (已实测连通)
# 注意：目标服务器 SSLRequest 返回 'N'（不支持 SSL），故 sslmode=disable
DATABASE_URL=postgres://gpt2apirstest:gpt2apirstest@156.238.232.88:5432/gpt2apirstest?sslmode=disable

# 管理面 API Key（未设置则启动失败）
AUTH_KEY=gpt2apirs-dev-key-change-me

# ---------- 数据目录 ----------
# 相对路径按「可执行文件所在目录」解析（不是 CWD）
# 开发：exe 在 target/debug，../../data -> <仓库根>/data（cargo clean 不会清掉）
# 生产：把二进制与 data/ 放同一目录，本项可删除
DATA_DIR=../../data

# ---------- 监听 ----------
HOST=0.0.0.0
PORT=8000

# ---------- 连接池（sqlx PgPoolOptions 语义）----------
DATABASE_MAX_CONNECTIONS=10
DATABASE_ACQUIRE_TIMEOUT_SECONDS=30
DATABASE_IDLE_TIMEOUT_SECONDS=600
DATABASE_MAX_LIFETIME_SECONDS=1800

# ---------- 日志 ----------
RUST_LOG=info,gpt2apirs=debug
LOG_LEVELS=info,warning,error

# 后台登录口令（与 AUTH_KEY 分离；AUTH_KEY 仅作为旧 API key 迁移用）
ADMIN_KEY=g2a-admin-local-dev-9f3c
