# 复制为 .env 放到可执行文件同目录（例如 target/release/.env）

# PostgreSQL 连接串
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/gpt2apirs?sslmode=disable

# 管理后台登录口令，至少 8 个字符，换成长随机串
# 调用 /v1/* 不用它，用后台「密钥」页创建的 API key
ADMIN_KEY=change-me-to-a-long-random-string

# 监听地址
HOST=0.0.0.0
PORT=8000

# 图片落盘目录
DATA_DIR=./data

# 对外基础地址（拼图片 URL 用），留空则按请求推导
PUBLIC_BASE_URL=

# 允许跨站调用 /v1/* 的来源（逗号分隔）。留空 = 放开任意来源。
# 这些接口只认 Authorization 里的 API key，不依赖 cookie，所以缺省是安全的。
# CORS_ALLOW_ORIGINS=https://your-frontend.example
