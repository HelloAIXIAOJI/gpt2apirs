# 复制为 .env 放到可执行文件同目录（例如 target/release/.env）

# PostgreSQL 连接串
DATABASE_URL=postgres://user:pass@127.0.0.1:5432/gpt2apirs?sslmode=disable

# 调用 /v1/* 的口令，至少 8 个字符，换成长随机串
AUTH_KEY=change-me-to-a-long-random-string

# 管理后台登录口令；留空则沿用 AUTH_KEY
ADMIN_KEY=change-me-to-another-long-random-string

# 监听地址
HOST=0.0.0.0
PORT=8000

# 图片落盘目录
DATA_DIR=./data

# 对外基础地址（拼图片 URL 用），留空则按请求推导
PUBLIC_BASE_URL=
